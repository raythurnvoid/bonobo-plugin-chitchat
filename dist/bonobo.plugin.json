{
	"schemaVersion": 1,
	"name": "chitchat",
	"displayName": "Chitchat",
	"version": "0.6.0",
	"description": "Team chat for the workspace: channels, one-level threads, reactions, workspace-file attachments, unread and mention badges, and Unreads, Threads, and Activity views. Messages live in the plugin's own document store, and a backend projects each channel into read-only Markdown transcript files.",
	"compatibility": {
		"bonoboPluginRuntime": "1"
	},
	"backend": {
		"entry": "dist/backend/worker.js",
		"moduleName": "plugin.js",
		"compatibilityDate": "2026-07-01",
		"compatibilityFlags": ["nodejs_compat"],
		"endpoints": [
			{ "id": "message-send", "path": "/messages/send", "serialization": "installation" },
			{ "id": "message-edit", "path": "/messages/edit", "serialization": "installation" },
			{ "id": "message-delete", "path": "/messages/delete", "serialization": "installation" },
			{ "id": "reply-send", "path": "/replies/send", "serialization": "installation" },
			{ "id": "reaction-toggle", "path": "/reactions/toggle", "serialization": "installation" },
			{ "id": "channel-manage", "path": "/channels/manage", "serialization": "installation" },
			{ "id": "reconcile", "path": "/reconcile", "serialization": "installation" }
		]
	},
