{
	"name": "@bonobo/plugin-chitchat",
	"private": true,
	"version": "0.8.4",
	"type": "module",
	"scripts": {
		"build": "vite build && prettier --write dist/frontend/assets/index.js dist/frontend/assets/index.css && node scripts/build-manifest.mjs",
		"build:manifest": "node scripts/build-manifest.mjs",
		"dev": "vite",
		"test": "vitest",
		"test:once": "vitest run --testTimeout 30000 --hookTimeout 30000 --teardownTimeout 30000",
		"typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json"
	},
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"@ariakit/react": "0.4.20",
		"bonobo-plugin-sdk": "github:raythurnvoid/bonobo-plugin-sdk#4b7d0ee3a83d8348de1b04c9587ba5ba3cdfad4e",
		"convex": "^1.42.2",
		"convex-helpers": "0.1.106",
		"jose": "6.1.3",
		"lucide-react": "^0.544.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@edge-runtime/vm": "5.0.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"convex-test": "0.0.53",
		"happy-dom": "20.0.11",
		"prettier": "3.8.3",
		"typescript": "^7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	}
}
