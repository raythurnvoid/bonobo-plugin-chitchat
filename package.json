{
	"name": "@bonobo/plugin-chitchat",
	"private": true,
	"version": "0.6.4",
	"type": "module",
	"scripts": {
		"build": "vite build && vite build --config vite.backend.config.ts && prettier --write dist/frontend/assets/index.js dist/frontend/assets/index.css dist/backend/worker.js && node scripts/build-manifest.mjs",
		"build:manifest": "node scripts/build-manifest.mjs",
		"dev": "vite",
		"test": "vitest",
		"test:once": "vitest run --testTimeout 30000 --hookTimeout 30000 --teardownTimeout 30000",
		"typecheck": "tsc --noEmit"
	},
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"@ariakit/react": "0.4.20",
		"bonobo-plugin-sdk": "github:raythurnvoid/bonobo-plugin-sdk#49b87d4e5bf51bb471ba79444dc2a5e82bc05a16",
		"lucide-react": "^0.544.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"happy-dom": "20.0.11",
		"prettier": "3.8.3",
		"typescript": "^7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	}
}
