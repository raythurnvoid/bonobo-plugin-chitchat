{
	"name": "@bonobo/plugin-chitchat",
	"private": true,
	"version": "0.8.12",
	"type": "module",
	"scripts": {
		"build": "vite build && prettier --write dist/frontend/assets/index.js dist/frontend/assets/index.css && node scripts/build-manifest.mjs",
		"build:manifest": "node scripts/build-manifest.mjs",
		"dev": "vite",
		"test": "vitest",
		"test:once": "vitest run --testTimeout 30000 --hookTimeout 30000 --teardownTimeout 30000",
		"typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json"
	},
	"packageManager": "pnpm@12.14.0",
	"dependencies": {
		"@ariakit/react": "0.4.42",
		"bonobo-plugin-sdk": "github:raythurnvoid/bonobo-plugin-sdk#ea875be3eaf4c51df85233a52fad095b8625c1b5",
		"convex": "1.47.0",
		"convex-helpers": "0.1.128",
		"jose": "6.1.3",
		"lucide-react": "0.544.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@edge-runtime/vm": "5.0.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"convex-test": "0.0.62",
		"happy-dom": "21.0.4",
		"prettier": "3.9.10",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
